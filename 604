<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRAVEBOX | Fast. Fresh. Flavorful.</title>
    <style>
        /* --- RESET & VARIABLES --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', Arial, sans-serif;
        }
        :root {
            --primary: #FF3E3E; /* Spicy Red */
            --secondary: #FFAA00; /* Mustard Yellow */
            --dark: #1A1A1A; /* Charcoal Black */
            --light: #F9F9F9;
            --white: #FFFFFF;
        }

        body {
            background-color: var(--light);
            color: var(--dark);
            line-height: 1.6;
        }

        /* --- NAVIGATION --- */
        header {
            background-color: var(--dark);
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 20px;
        }
        .logo {
            color: var(--secondary);
            font-size: 28px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .logo span {
            color: var(--white);
        }
        .nav-links {
            list-style: none;
            display: flex;
            gap: 25px;
        }
        .nav-links a {
            color: var(--white);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s;
        }
        .nav-links a:hover {
            color: var(--secondary);
        }
        .cta-btn {
            background-color: var(--primary);
            color: var(--white);
            padding: 10px 20px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 700;
            transition: transform 0.2s, background-color 0.3s;
        }
        .cta-btn:hover {
            background-color: #e03232;
            transform: scale(1.05);
        }

        /* --- HERO SECTION --- */
        .hero {
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.7)), url('https://images.unsplash.com/photo-1561758033-d89a9ad46330?q=80&w=1600&auto=format&fit=crop') no-repeat center center/cover;
            height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: var(--white);
            padding: 0 20px;
        }
        .hero-content h1 {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 15px;
            text-transform: uppercase;
        }
        .hero-content p {
            font-size: 1.3rem;
            margin-bottom: 30px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }
        .hero-btns {
            display: flex;
            justify-content: center;
            gap: 15px;
        }
        .btn-secondary {
            background-color: var(--secondary);
            color: var(--dark);
        }
        .btn-secondary:hover {
            background-color: #e69900;
        }

        /* --- SECTION STYLING --- */
        section {
            padding: 60px 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .section-title {
            text-align: center;
            font-size: 2.5rem;
            margin-bottom: 40px;
            position: relative;
            text-transform: uppercase;
        }
        .section-title::after {
            content: '';
            display: block;
            width: 60px;
            height: 4px;
            background-color: var(--primary);
            margin: 10px auto 0;
            border-radius: 2px;
        }

        /* --- MENU GRID --- */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }
        .menu-card {
            background-color: var(--white);
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            transition: transform 0.3s;
            text-align: center;
        }
        .menu-card:hover {
            transform: translateY(-5px);
        }
        .menu-img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            background-color: #ddd;
        }
        .menu-info {
            padding: 20px;
        }
        .menu-info h3 {
            font-size: 1.4rem;
            margin-bottom: 10px;
        }
        .menu-info p {
            color: #666;
            font-size: 0.95rem;
            margin-bottom: 15px;
            height: 45px;
            overflow: hidden;
        }
        .menu-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .price {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--primary);
        }

        /* --- PROMO SECTION --- */
        .promo-banner {
            background-color: var(--secondary);
            color: var(--dark);
            text-align: center;
            padding: 40px 20px;
            border-radius: 15px;
            margin: 40px auto;
        }
        .promo-banner h2 {
            font-size: 2rem;
            margin-bottom: 10px;
        }

        /* --- FOOTER --- */
        footer {
            background-color: var(--dark);
            color: #999;
            text-align: center;
            padding: 40px 20px;
            margin-top: 60px;
        }
        footer p {
            margin-bottom: 10px;
        }

        /* --- RESPONSIVE DESIGN --- */
        @media (max-width: 768px) {
            .nav-links { display: none; } /* Simplified for mobile */
            .hero-content h1 { font-size: 2.2rem; }
            .hero-content p { font-size: 1rem; }
            .hero-btns { flex-direction: column; }
        }
    </style>
</head>
<body>

    <header>
        <div class="nav-container">
            <div class="logo">CRAVE<span>BOX</span></div>
            <ul class="nav-links">
                <li><a href="#menu">Menu</a></li>
                <li><a href="#deals">Deals</a></li>
                <li><a href="#locations">Locations</a></li>
            </ul>
            <a href="#" class="cta-btn">Order Online</a>
        </div>
    </header>

    <section class="hero">
        <div class="hero-content">
            <h1>Late Night Cravings?</h1>
            <p>Juicy smashed burgers, crispy golden fries, and shakes so thick you'll need a spoon. Delivered hot in 30 mins.</p>
            <div class="hero-btns">
                <a href="#menu" class="cta-btn btn-secondary">View Menu</a>
                <a href="#" class="cta-btn">Order Delivery</a>
            </div>
        </div>
    </section>

    <section id="menu">
        <h2 class="section-title">Fan Favorites</h2>
        <div class="menu-grid">
            
            <div class="menu-card">
                <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?q=80&w=600&auto=format&fit=crop" alt="Burger" class="menu-img">
                <div class="menu-info">
                    <h3>The Monster Smash</h3>
                    <p>Double beef patty, cheddar, secret CraveSauce, brioche bun.</p>
                    <div class="menu-footer">
                        <span class="price">$8.99</span>
                        <a href="#" class="cta-btn">Add</a>
                    </div>
                </div>
            </div>

            <div class="menu-card">
                <img src="https://images.unsplash.com/photo-1573080496219-bb080dd4f877?q=80&w=600&auto=format&fit=crop" alt="Fries" class="menu-img">
                <div class="menu-info">
                    <h3>Loaded Fire Fries</h3>
                    <p>Crispy fries topped with melted cheese, jalapenos, and bacon crisp.</p>
                    <div class="menu-footer">
                        <span class="price">$5.49</span>
                        <a href="#" class="cta-btn">Add</a>
                    </div>
                </div>
            </div>

            <div class="menu-card">
                <img src="https://images.unsplash.com/photo-1572490122747-3968b75cc699?q=80&w=600&auto=format&fit=crop" alt="Shake" class="menu-img">
                <div class="menu-info">
                    <h3>Salted Caramel Shake</h3>
                    <p>Hand-spun premium vanilla ice cream with thick artisanal caramel.</p>
                    <div class="menu-footer">
                        <span class="price">$4.99</span>
                        <a href="#" class="cta-btn">Add</a>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <section id="deals">
        <div class="promo-banner">
            <h2>Get The Squad Box for only $34.99!</h2>
            <p>4 Classic Burgers, 2 Large Fries, 10 Mozzarella Sticks, and 4 Drinks. Perfect for game night.</p>
            <br>
            <a href="#" class="cta-btn" style="background-color: var(--dark);">Claim Deal</a>
        </div>
    </section>

    <footer>
        <p>&copy; 2026 CraveBox Inc. All rights reserved.</p>
        <p>Open late until 3:00 AM on weekends.</p>
    </footer>

</body>
</html>
